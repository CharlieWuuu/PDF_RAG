# 資料庫憑證：docker-compose 會讀取這裡，不寫死在版控檔案中
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=pdf_rag

# 應用程式的連線字串（需與上方帳密一致）
DATABASE_URL=postgresql://postgres:change-me-in-production@localhost:5433/pdf_rag

# Gemini：embedding 與回答生成共用同一把金鑰（有免費額度）
GEMINI_API_KEY=...

# Embedding
# Gemini 預設 3072 維，這裡指定 1536 以沿用 vector(1536) 欄位
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# 回答生成
LLM_MODEL=gemini-3.5-flash-lite

# 切塊參數（以字元數計算，對中文較直觀）
CHUNK_SIZE=300
CHUNK_OVERLAP=60

# 檢索參數
TOP_K=8
# cosine distance 門檻：最佳結果大於此值視為找不到相關內容，不呼叫 LLM
SIMILARITY_THRESHOLD=0.55

PORT=3001

# 上傳大小上限（MB）。部署環境記憶體較小時需調低
MAX_UPLOAD_MB=40

# 允許呼叫 API 的前端來源，以逗號分隔（正式環境填 Vercel 網址）
CORS_ORIGINS=http://localhost:3000
