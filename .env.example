# 資料庫：本機用 docker-compose，正式環境換成 Neon 連線字串即可
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pdf_rag

# Gemini：embedding 與回答生成共用同一把金鑰（有免費額度）
GEMINI_API_KEY=...

# Embedding
# Gemini 預設 3072 維，這裡指定 1536 以沿用 vector(1536) 欄位
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# 回答生成
LLM_MODEL=gemini-3.5-flash-lite

# 切塊參數（以字元數計算，對中文較直觀）
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# 檢索參數
TOP_K=5
# cosine distance 門檻：最佳結果大於此值視為找不到相關內容，不呼叫 LLM
SIMILARITY_THRESHOLD=0.55

PORT=3001
