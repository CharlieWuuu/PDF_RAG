# 資料庫：本機用 docker-compose，正式環境換成 Neon 連線字串即可
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pdf_rag

# Embedding
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# 回答生成
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5

# 切塊參數（以字元數計算，對中文較直觀）
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# 檢索參數
TOP_K=5
# cosine distance 門檻：最佳結果大於此值視為找不到相關內容，不呼叫 LLM
SIMILARITY_THRESHOLD=0.55

PORT=3001
